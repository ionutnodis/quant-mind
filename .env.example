# IBKR connection. Keep one explicit account selected when a login exposes
# multiple accounts; QuantMind refuses to aggregate them silently.
QM_HOST=127.0.0.1
QM_PORT=4002
QM_CLIENT_ID=17
QM_ACCOUNT_ID=

# Local evidence cache and analytical defaults
QM_DATA_DIR=data
# Optional override for deployments whose built frontend is outside ./web/dist.
# QM_WEB_DIST=/absolute/path/to/web/dist
QM_BENCHMARK=SPY
QM_BASE_CURRENCY=USD
QM_N_PATHS=10000

# Optional comma-separated free fallback. IBKR remains authoritative for any
# symbol it already supplies.
QM_YFINANCE_SYMBOLS=

# Disabled by default. When enabled, sync enriches IBKR-identified ETF share
# classes from justETF using an ISIN-keyed, 30-day local cache.
QM_UCITS_METADATA_ENABLED=false

# Optional local API protection. Leave blank for the simplest loopback-only
# first run; never expose the process beyond localhost.
QM_API_TOKEN=
QM_API_ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000,http://127.0.0.1:5173,http://localhost:5173
