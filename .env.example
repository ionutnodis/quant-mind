# IBKR connection. Keep one explicit account selected when a login exposes
# multiple accounts; QuantMind refuses to aggregate them silently.
QM_HOST=127.0.0.1
QM_PORT=4002
QM_CLIENT_ID=17
QM_ACCOUNT_ID=

# Local evidence cache and analytical defaults
QM_DATA_DIR=data
# Optional override for deployments whose built frontend is outside ./web/dist.
# QM_WEB_DIST=/absolute/path/to/web/dist
QM_BENCHMARK=SPY
QM_BASE_CURRENCY=USD
QM_N_PATHS=10000

# Optional comma-separated free fallback. IBKR remains authoritative for any
# symbol it already supplies.
QM_YFINANCE_SYMBOLS=

# Disabled by default. When enabled, sync enriches IBKR-identified ETF share
# classes from justETF using an ISIN-keyed, 30-day local cache.
QM_UCITS_METADATA_ENABLED=false

# World monitor: 14 public sources need no key. Open /world and Refresh sources,
# or run: uv run python -m quantmind.world_cli --watch --interval 300
# Optional SEC press feed requires a real identifying contact, not this example.
QM_WORLD_SEC_USER_AGENT=

# X is NOT a free data source. Keep disabled unless you accept API charges.
# Use a bounded query such as from:your_chosen_account; set spending limits in
# the X developer console. Never use a VITE_ variable for provider credentials.
QM_WORLD_X_ENABLED=false
QM_WORLD_X_BEARER_TOKEN=
QM_WORLD_X_QUERY=

# Reddit requires approved API access and an OAuth refresh token with read scope.
# All credentials remain server-side; no password-based login or HTML scraping.
QM_WORLD_REDDIT_ENABLED=false
QM_WORLD_REDDIT_CLIENT_ID=
QM_WORLD_REDDIT_CLIENT_SECRET=
QM_WORLD_REDDIT_REFRESH_TOKEN=
QM_WORLD_REDDIT_USER_AGENT=
QM_WORLD_REDDIT_SUBREDDITS=investing,stocks,Economics

# Optional local API protection. Leave blank for the simplest loopback-only
# first run; never expose the process beyond localhost.
QM_API_TOKEN=
QM_API_ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000,http://127.0.0.1:5173,http://localhost:5173
